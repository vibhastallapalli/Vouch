pragma language_version >= 0.22;

import CompactStandardLibrary;

// Stub entrypoints only, no circuit logic yet. Shapes follow interface.md
// sections 8 and 9; every body below gets its real logic in later tasks.

// Approved issuer registry (interface.md section 1): seeded at deployment,
// MOCKED registry, keys generated by us, not a live authority.
export sealed ledger approvedIssuerIncome: Bytes<32>;
export sealed ledger approvedIssuerReference: Bytes<32>;

// One entry per (applicant, listing), interface.md section 5.
export ledger nullifiers: Set<Bytes<32>>;

constructor(issuerIncomeKey: Bytes<32>, issuerReferenceKey: Bytes<32>) {
  approvedIssuerIncome = disclose(issuerIncomeKey);
  approvedIssuerReference = disclose(issuerReferenceKey);
}

// Applicant joins a listing pool: proves all hard badges, binds identity
// commitment C, spends per-listing nullifier. interface.md sections 6, 8.
export circuit apply(listingId: Bytes<32>, nullifier: Bytes<32>): [] {
  assert(!nullifiers.member(disclose(nullifier)), "already applied to this listing");
  nullifiers.insert(disclose(nullifier));
}

// Landlord commits to one pool entry by its identity commitment C.
export circuit commitToApplicant(listingId: Bytes<32>, applicantC: Bytes<32>): [] {
}

// Committed applicant opens C and pays the deposit into escrow in one
// transaction. interface.md section 9 step 2.
export circuit revealAndDeposit(listingId: Bytes<32>): [] {
}

// Deposit released to landlord on confirm.
export circuit confirmRelease(listingId: Bytes<32>): [] {
}

// Deposit returns to applicant if the deal is dead.
export circuit refund(listingId: Bytes<32>): [] {
}
