pragma language_version >= 0.22;

import CompactStandardLibrary;

// Circuit shapes follow interface.md sections 8 and 9. apply, commitToApplicant,
// and revealAndDeposit carry real logic; confirmRelease and refund are still
// stubs. NOTE: not compiled on this machine (no Compact CLI on PATH here); the
// commit/reveal bodies are written by mirroring the compiled apply circuit's
// proven idioms and must be compiled on the toolchain machine. See README
// limitations.

// Identity fields bound under the commitment C (interface.md section 2).
// C binds pk = H(s), never s itself, so opening C at reveal cannot leak the
// nullifier seed.
struct IdentityFields {
  nameHash: Bytes<32>;
  dobHash: Bytes<32>;
  contactHash: Bytes<32>;
  pk: Bytes<32>;
}

// One pool entry per application: the listing and the applicant's identity
// commitment C. Both public by design (interface.md section 10).
struct PoolEntry {
  listingId: Bytes<32>;
  c: Bytes<32>;
}

// Approved issuer registry (interface.md section 1): seeded at deployment,
// MOCKED registry, keys generated by us, not a live authority.
export sealed ledger approvedIssuerIncome: Bytes<32>;
export sealed ledger approvedIssuerReference: Bytes<32>;

// One entry per (applicant, listing), interface.md section 5.
export ledger nullifiers: Set<Bytes<32>>;

// The anonymous applicant pool, interface.md section 6.
export ledger pool: Set<PoolEntry>;

// Landlord's commitment: the pool entry (listing + C) it commits to, plus the
// listings already committed so a listing cannot be committed twice.
// interface.md section 9.
export ledger commits: Set<PoolEntry>;
export ledger committedListings: Set<Bytes<32>>;

// Listings whose committed applicant has revealed and paid the deposit. MOCKED
// escrow: this records status only, no real shielded-coin custody. See README.
export ledger deposited: Set<Bytes<32>>;

// Applicant-local wallet state (interface.md section 2). Never on chain.
witness identitySecret(): Bytes<32>;
witness identityBlinding(): Bytes<32>;
witness identityNameHash(): Bytes<32>;
witness identityDobHash(): Bytes<32>;
witness identityContactHash(): Bytes<32>;

// Income figure from the income credential's claims. MOCKED trust for now:
// the issuer signature over this claim is only verified once the registry
// check task lands, so until then the value is applicant-asserted.
witness monthlyIncome(): Uint<64>;

constructor(issuerIncomeKey: Bytes<32>, issuerReferenceKey: Bytes<32>) {
  approvedIssuerIncome = disclose(issuerIncomeKey);
  approvedIssuerReference = disclose(issuerReferenceKey);
}

// Applicant joins a listing pool: proves the income badge, binds identity
// commitment C, spends the per-listing nullifier. interface.md sections 2,
// 5, 6, 8. Rent and ratio are the listing's public terms; income stays in
// the witness.
export circuit apply(listingId: Bytes<32>, monthlyRent: Uint<64>, incomeRatio: Uint<8>): [] {
  // Income threshold badge: monthlyIncome >= k * monthlyRent.
  assert(monthlyIncome() >= incomeRatio * monthlyRent, "income below listing threshold");

  // Identity commitment binding: pk = H("rentpool:pk", s), C opens over the
  // identity fields plus pk under blinding r.
  const s = identitySecret();
  const pk = persistentHash<Vector<2, Bytes<32>>>([pad(32, "rentpool:pk"), s]);
  const c = persistentCommit<IdentityFields>(
    IdentityFields {
      nameHash: identityNameHash(),
      dobHash: identityDobHash(),
      contactHash: identityContactHash(),
      pk: pk
    },
    identityBlinding()
  );

  // Per-listing nullifier: N = H("rentpool:null", s, listingId). Derived in
  // circuit from s, so it is unforgeable and unlinkable across listings.
  const nullifier = persistentHash<Vector<3, Bytes<32>>>([pad(32, "rentpool:null"), s, listingId]);
  assert(!nullifiers.member(disclose(nullifier)), "already applied to this listing");
  nullifiers.insert(disclose(nullifier));

  pool.insert(disclose(PoolEntry { listingId: listingId, c: c }));
}

// Landlord commits to one pool entry by its identity commitment C. Both args
// are public listing data, so no disclosure is needed. The C must be a real
// entry in this listing's pool, and a listing can only be committed once.
export circuit commitToApplicant(listingId: Bytes<32>, applicantC: Bytes<32>): [] {
  assert(pool.member(PoolEntry { listingId: listingId, c: applicantC }), "not a pool entry for this listing");
  assert(!committedListings.member(listingId), "listing already committed");
  committedListings.insert(listingId);
  commits.insert(PoolEntry { listingId: listingId, c: applicantC });
}

// Committed applicant opens C and pays the deposit into escrow in one
// transaction. interface.md section 9 step 2. Recomputing C exactly as apply
// does (pk = H(s), C = commit(identity fields, r)) proves ownership: only the
// person behind the committed C can produce an opening that lands in commits.
export circuit revealAndDeposit(listingId: Bytes<32>): [] {
  const s = identitySecret();
  const pk = persistentHash<Vector<2, Bytes<32>>>([pad(32, "rentpool:pk"), s]);
  const c = persistentCommit<IdentityFields>(
    IdentityFields {
      nameHash: identityNameHash(),
      dobHash: identityDobHash(),
      contactHash: identityContactHash(),
      pk: pk
    },
    identityBlinding()
  );
  assert(commits.member(disclose(PoolEntry { listingId: listingId, c: c })), "not the committed applicant");

  // MOCKED deposit: escrow status only. Real shielded-coin custody
  // (send/receiveShielded, zswap) is not wired; see README limitations.
  assert(!deposited.member(listingId), "deposit already made");
  deposited.insert(listingId);
}

// Deposit released to landlord on confirm.
export circuit confirmRelease(listingId: Bytes<32>): [] {
}

// Deposit returns to applicant if the deal is dead.
export circuit refund(listingId: Bytes<32>): [] {
}
